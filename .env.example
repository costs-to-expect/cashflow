APP_NAME="Costs to Expect: Cashflow"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://cashflow.costs-to-expect.local:8081

APP_ALLOWED_EMAILS=

# What a "resource" is called in the UI before a resource type has its own
# naming set from Settings.
APP_RESOURCE_TERM=Child
APP_RESOURCE_TERM_PLURAL=Children

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Costs to Expect API. When running via docker-compose alongside the API's
# own containers (shared "costs.network"), use the API's container name;
# otherwise point at wherever the API is reachable (e.g. http://localhost:8080
# for the API's own local dev docker-compose setup).
API_URL=http://costs.api.app
API_DEFAULT_CURRENCY_ID=
# Most GET/HEAD requests a pooled batch sends at once (0 = no cap). The API's
# rate limit is currently 60 requests a minute, see config/app/api.php.
API_POOL_CONCURRENCY=6
# Long-lived token for the recurring-expense scheduler (see config/app/api.php)
API_SERVICE_TOKEN=

DB_CONNECTION=mysql
DB_HOST=costs.cashflow.mysql
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_ROOT_PASSWORD=

CACHE_STORE=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false

COMPOSE_PROJECT_NAME="costs-to-expect-cashflow"
