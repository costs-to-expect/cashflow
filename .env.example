APP_NAME="Costs to Expect: Expense"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://expense.costs-to-expect.local:8081

APP_ALLOWED_EMAILS=

# What a "resource" under the fixed resource type is called in the UI.
APP_RESOURCE_TERM=Child
APP_RESOURCE_TERM_PLURAL=Children

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Costs to Expect API. When running via docker-compose alongside the API's
# own containers (shared "costs.network"), use the API's container name;
# otherwise point at wherever the API is reachable (e.g. http://localhost:8080
# for the API's own local dev docker-compose setup).
API_URL=http://costs.api.app
API_RESOURCE_TYPE_ID=d185Q15grY
API_ITEM_TYPE_ID=OqZwKX16bW
API_ITEM_SUBTYPE_ID=a56kbWV82n
API_DEFAULT_CURRENCY_ID=
# Long-lived token for the recurring-expense scheduler (see config/api.php)
API_SERVICE_TOKEN=

DB_CONNECTION=mysql
DB_HOST=costs.expense.mysql
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_ROOT_PASSWORD=

CACHE_STORE=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false

COMPOSE_PROJECT_NAME="costs-to-expect-expense"
